# Database
DATABASE_URL="postgresql://weddingletter:weddingletter@localhost:5432/weddingletter?schema=public"

# Auth
JWT_SECRET="change-me"
# Lama sesi login. Bergulir: diperpanjang otomatis tiap user aktif, jadi cukup 30 hari.
JWT_EXPIRES_IN="30d"

# Batas kode OTP email (hemat kuota Resend: paket gratis 100/hari, 3.000/bulan)
OTP_DAILY_LIMIT=90
OTP_PER_EMAIL_DAILY=8
GOOGLE_CLIENT_ID=""

# Cloudflare R2 (object storage untuk foto/video/lagu)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="weddingletter-media"
R2_PUBLIC_URL=""

# Payment Gateway
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Notifikasi
FONNTE_TOKEN=""
RESEND_API_KEY=""
MAIL_FROM="WeddingLetter <onboarding@resend.dev>"

# App
APP_PORT=4000
APP_BASE_URL="http://localhost:4000"
WEB_BASE_URL="http://localhost:3000"

# Opsional
# UPLOAD_DIR="uploads"       # folder storage lokal (dev tanpa R2)
# TRUST_PROXY=1              # di belakang Nginx/Cloudflare
# DISABLE_JOBS=true          # matikan job pemeliharaan berkala
