// WeddingLetter database schema
// Mirrors the entity design in the project plan doc, Bagian 8 & 10.
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TemplateTier {
  BASIC
  STANDARD
  PREMIUM
}

enum AddOnType {
  FLAT
  PER_UNIT
}

enum CouponType {
  PERCENT
  NOMINAL
}

enum CouponStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}

// NEW = pembelian template baru, EXTENSION = perpanjangan masa aktif undangan yang sudah ada.
enum OrderKind {
  NEW
  EXTENSION
}

enum InvitationStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED_GRACE
  DELETED
}

enum MediaType {
  PHOTO
  VIDEO
  SONG
}

// PENDING = sudah dideklarasikan (dan dihitung harganya) tapi file belum diunggah,
// UPLOADED = file sudah ada di storage, menunggu undangan dipublikasikan.
enum MediaStatus {
  PENDING
  UPLOADED
  ACTIVE
  PAUSED
  EXPIRED_GRACE
  DELETED
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phone           String?
  passwordHash    String?
  googleId        String?   @unique
  emailVerifiedAt DateTime?
  role            Role      @default(USER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orders Order[]

  @@map("users")
}

// Kode OTP login (email). Disimpan sebagai HMAC, bukan plaintext.
model OtpCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@map("otp_codes")
}

model Template {
  id            String         @id @default(cuid())
  name          String
  category      String
  tier          TemplateTier
  price         Int
  // Berapa minggu masa aktif yang sudah termasuk di harga dasar template (perpanjangan: add-on EXTEND_ACTIVE_WEEK).
  includedWeeks Int            @default(4)
  status        TemplateStatus @default(DRAFT)
  layoutSchema  Json
  thumbnailUrl  String?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  invitations Invitation[]
  orders      Order[]

  @@map("templates")
}

model AddOn {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  type      AddOnType
  price     Int
  unit      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  orderAddOns OrderAddOn[]

  @@map("add_ons")
}

model Coupon {
  id        String       @id @default(cuid())
  code      String       @unique
  type      CouponType
  value     Int
  quota     Int?
  usedCount Int          @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  status    CouponStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  orders Order[]

  @@map("coupons")
}

model Order {
  id                  String      @id @default(cuid())
  kind                OrderKind   @default(NEW)
  userId              String
  templateId          String
  couponId            String?
  // Hanya untuk kind = EXTENSION: undangan yang diperpanjang.
  extendsInvitationId String?
  // Total minggu masa aktif yang dibeli (NEW: termasuk minggu bawaan template; EXTENSION: minggu tambahan).
  activeWeeks         Int         @default(4)
  subtotal            Int
  addOnTotal          Int         @default(0)
  couponDiscount      Int         @default(0)
  totalAmount         Int
  status              OrderStatus @default(PENDING)
  paymentRef          String?
  paymentProvider     String?
  paymentToken        String?
  paymentUrl          String?
  paidAt              DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user              User         @relation(fields: [userId], references: [id])
  template          Template     @relation(fields: [templateId], references: [id])
  coupon            Coupon?      @relation(fields: [couponId], references: [id])
  extendsInvitation Invitation?  @relation("InvitationExtensions", fields: [extendsInvitationId], references: [id])
  addOns            OrderAddOn[]
  invitation        Invitation?  @relation("InvitationOrigin")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderAddOn {
  id              String   @id @default(cuid())
  orderId         String
  addOnId         String
  quantity        Int      @default(1)
  priceAtPurchase Int
  createdAt       DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
  addOn AddOn @relation(fields: [addOnId], references: [id])

  @@map("order_add_ons")
}

model Invitation {
  id             String           @id @default(cuid())
  orderId        String           @unique
  templateId     String
  // Isi undangan: { [sectionId]: { [fieldKey]: nilai } } sesuai layoutSchema template.
  data           Json
  // Fitur tambahan hasil add-on, mis. { rsvp: true, envelope: true, english: true }.
  features       Json             @default("{}")
  // Snapshot skema template (tema, section, kuota) saat dibeli, supaya perubahan template oleh admin
  // tidak merusak undangan yang sudah dibayar.
  layout         Json             @default("{}")
  slug           String           @unique
  status         InvitationStatus @default(DRAFT)
  publishedAt    DateTime?
  expiresAt      DateTime?
  pausedAt       DateTime?
  remainingDays  Int?
  reminderSentAt DateTime?
  viewCount      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  order           Order       @relation("InvitationOrigin", fields: [orderId], references: [id])
  template        Template    @relation(fields: [templateId], references: [id])
  extensionOrders Order[]     @relation("InvitationExtensions")
  mediaFiles      MediaFile[]
  guests          RsvpGuest[]

  @@index([status, expiresAt])
  @@map("invitations")
}

model MediaFile {
  id            String      @id @default(cuid())
  invitationId  String
  type          MediaType
  storageKey    String
  url           String
  contentType   String
  // Ukuran yang dideklarasikan saat order (dan dibayar); dicek ulang saat konfirmasi upload.
  sizeBytes     Int
  sizeMb        Float
  // false = kena tarif sewa ukuran x durasi (Bagian 7.1); true = termasuk kuota tier / paket foto.
  included      Boolean     @default(true)
  rentedWeeks   Int
  rentalPrice   Int
  // Bila diisi: file ini pengganti media lain (mengganti foto/video/lagu setelah pembelian).
  replacesId    String?
  status        MediaStatus @default(PENDING)
  expiresAt     DateTime?
  remainingDays Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id])

  @@index([invitationId])
  @@index([status, expiresAt])
  @@map("media_files")
}

model RsvpGuest {
  id           String   @id @default(cuid())
  invitationId String
  name         String
  attending    Boolean?
  guestCount   Int      @default(1)
  message      String?
  createdAt    DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id])

  @@index([invitationId, createdAt])
  @@map("rsvp_guests")
}

// Pustaka lagu bawaan yang dikelola admin (Admin -> Musik). Tersedia untuk pembeli sesuai `minTier`:
// BASIC = semua paket (mis. musik klasik domain publik), STANDARD = Standard & Premium, PREMIUM = Premium saja.
enum MusicLicense {
  PUBLIC_DOMAIN
  CC0
  ROYALTY_FREE
  CC_BY
  OTHER
}

enum MusicStatus {
  ACTIVE
  ARCHIVED
}

model MusicTrack {
  id          String       @id @default(cuid())
  title       String
  // Komposer / pemain / label.
  artist      String
  licenseType MusicLicense
  // Catatan lisensi bebas (mis. "Komposisi: domain publik. Rekaman: Musopen, CC0").
  licenseNote String?
  sourceUrl   String?
  // Teks kredit yang wajib ditampilkan di undangan (mis. lisensi CC BY). Kosong = tidak ditampilkan.
  attribution String?
  minTier     TemplateTier @default(STANDARD)
  storageKey  String       @unique
  sizeBytes   Int
  durationSec Int?
  sortOrder   Int          @default(0)
  status      MusicStatus  @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, minTier, sortOrder])
  @@map("music_tracks")
}
