# Nginx staging. ${STAGING_DOMAIN} diisi dari env container (docker-compose.yml).
# Seluruh situs dikunci basic auth + noindex, kecuali webhook Midtrans (server Midtrans tidak bisa login)
# dan robots.txt.

server {
    listen 80;
    listen [::]:80;
    server_name ${STAGING_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${STAGING_DOMAIN};

    # Cloudflare Origin CA (SSL/TLS mode "Full (strict)" di Cloudflare).
    ssl_certificate     /etc/nginx/certs/origin.pem;
    ssl_certificate_key /etc/nginx/certs/origin.key;

    include /etc/nginx/snippets/cloudflare-realip.conf;

    # Foto/video/lagu diunggah langsung dari browser ke R2 (presigned URL), bukan lewat server ini.
    client_max_body_size 2m;

    add_header X-Robots-Tag "noindex, nofollow" always;

    # Nama container di-resolve ulang lewat DNS Docker (proxy_pass dengan variabel). Tanpa ini Nginx menyimpan
    # IP lama dan membalas 502 setelah deploy membuat ulang container web/api.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $web_upstream http://web:3000;
    set $api_upstream http://api:4000;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Ditimpa (bukan ditambah) supaya tamu tidak bisa memalsukan IP; $remote_addr sudah IP asli dari Cloudflare.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;

    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    # Notifikasi pembayaran Midtrans -> API (tanda tangan diverifikasi di PaymentsService).
    location = /payments/midtrans/notification {
        proxy_pass $api_upstream;
    }

    location / {
        auth_basic "WeddingLetter staging";
        auth_basic_user_file /etc/nginx/htpasswd;
        proxy_pass $web_upstream;
    }
}
