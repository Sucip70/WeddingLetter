# Salin ke .env di server (folder ~/weddingletter-staging). Dibaca docker compose.
STAGING_DOMAIN=staging.weddingletter.id

# Huruf/angka saja (dipakai di DATABASE_URL tanpa encoding): openssl rand -hex 24
POSTGRES_PASSWORD=

# Nama image di GHCR, huruf kecil semua (sama dengan yang dibangun GitHub Actions).
API_IMAGE=ghcr.io/sucip70/weddingletter-api
WEB_IMAGE=ghcr.io/sucip70/weddingletter-web
# TAG diisi otomatis saat deploy (staging-<sha commit>); bawaan = staging (build terakhir).
