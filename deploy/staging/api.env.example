# Salin ke api.env di server. Env container API (DATABASE_URL, NODE_ENV, APP_PORT, TRUST_PROXY diatur
# docker-compose.yml). Di NODE_ENV=production API menolak jalan tanpa JWT_SECRET kuat, R2, dan Resend,
# dan pembayaran dev (DevProvider) mati: staging memakai Midtrans Sandbox sungguhan.

# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=30d

APP_BASE_URL=https://staging.weddingletter.id
WEB_BASE_URL=https://staging.weddingletter.id

# Kuota OTP email (paket gratis Resend: 100/hari)
OTP_DAILY_LIMIT=90
OTP_PER_EMAIL_DAILY=8
# Opsional: login Google (Authorized JavaScript origins harus memuat domain staging)
GOOGLE_CLIENT_ID=

# Cloudflare R2: bucket KHUSUS staging (jangan dipakai bersama production)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=weddingletter-staging
# URL publik bucket (r2.dev atau custom domain, mis. https://media-staging.weddingletter.id), tanpa / di akhir
R2_PUBLIC_URL=

# Midtrans SANDBOX (dashboard.sandbox.midtrans.com)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Resend: domain pengirim harus terverifikasi
RESEND_API_KEY=
MAIL_FROM=WeddingLetter Staging <noreply@weddingletter.id>

# Opsional: WhatsApp (kosongkan untuk mematikan)
FONNTE_TOKEN=
