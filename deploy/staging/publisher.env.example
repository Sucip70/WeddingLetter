# Copy to REPOSITORY_ROOT/.env.publisher (ignored by Git).
# Source DATABASE_URL and R2_* are loaded from apps/api/.env.
TARGET_R2_ACCOUNT_ID=
TARGET_R2_ACCESS_KEY_ID=
TARGET_R2_SECRET_ACCESS_KEY=
TARGET_R2_BUCKET_NAME=weddingletter-staging
TARGET_R2_PUBLIC_URL=https://YOUR-STAGING-BUCKET.r2.dev
# Admin bearer token from the staging login session. Never commit this token.
PUBLISHER_TOKEN=
